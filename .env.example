# News automation: server-side only. Never expose secrets through NEXT_PUBLIC_ variables.
NEWS_AUTOMATION_ENABLED=true
NEWS_AUTO_PUBLISH=true
NEWS_AUTOMATION_TIMEZONE=Asia/Shanghai
# Admin authentication: use unique values and keep them server-side only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-admin-password
ADMIN_JWT_SECRET=replace-with-an-independent-long-random-session-secret
# Inquiry notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=mailer@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=mailer@example.com
ADMIN_NOTIFICATION_EMAIL=sales@example.com
# Third-party Blog webhook authentication.
WEBHOOK_ARTICLE_SIGN=replace-with-a-long-random-webhook-secret
# Required in Vercel production for cron authorization and durable automation data.
CRON_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Existing Google Search Console service-account variables enable sitemap submission only.
GSC_SITE_URL=sc-domain:cowinsupply.com
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=service-account@example.iam.gserviceaccount.com
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=replace-with-service-account-private-key
# Optional. Required only when a separately approved AI content provider is configured.
OPENAI_API_KEY=
